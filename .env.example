# Copy to .env. Never commit real secrets.
DATABASE_URL="file:./dev.db"

# Webhook HMAC secrets (HMAC-SHA256 over the raw body). Required in production.
EMAIL_WEBHOOK_SECRET=""
WHATSAPP_APP_SECRET=""
TRANSACTIONS_WEBHOOK_SECRET=""

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""

# Extractor: "mock" (default) or "claude" (needs ANTHROPIC_API_KEY)
EXTRACTOR="mock"
ANTHROPIC_API_KEY=""

# Logging. LOG_LEVEL: info (default) | warn | error. LOG_FORMAT: pretty | json (default: pretty under `npm run dev`, json otherwise)
LOG_LEVEL="info"
# LOG_FORMAT="json"

# Where uploaded document bytes are stored (local fs BlobStore)
BLOB_DIR="./data/blobs"
