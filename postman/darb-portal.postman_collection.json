{
  "info": {
    "name": "Darb Portal webhooks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run against `npm run dev` after `npm run db:seed`.\n\nSigning: set emailSecret / whatsappSecret / transactionsSecret / verifyToken to the SAME values the server was started with and set serverHasSecrets=true. A collection pre-request script then HMAC-signs each POST body automatically. Leave them empty for an unsigned dev server.\n\nChange runId to a new value (or delete it) to send fresh message ids. Review results at {{baseUrl}}/review."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Signs POST bodies with HMAC-SHA256 over the EXACT bytes sent, like the real providers do.",
          "// Skipped when the matching secret variable is empty (dev mode: server accepts unsigned requests) or when the",
          "// request carries the x-skip-sign header (used by the \"forged signature\" request).",
          "if (!pm.variables.get('runId')) pm.collectionVariables.set('runId', String(Date.now()));",
          "const cryptoJs = require('crypto-js'); // explicit require: the bare CryptoJS global is deprecated",
          "if (pm.request.method === 'POST' && pm.request.body && pm.request.body.raw && !pm.request.headers.has('x-skip-sign')) {",
          "  const path = pm.request.url.getPath();",
          "  let secret, header;",
          "  if (path.includes('/webhooks/email')) { secret = pm.variables.get('emailSecret'); header = 'x-signature-256'; }",
          "  else if (path.includes('/webhooks/whatsapp')) { secret = pm.variables.get('whatsappSecret'); header = 'x-hub-signature-256'; }",
          "  else if (path.includes('/webhooks/transactions')) { secret = pm.variables.get('transactionsSecret'); header = 'x-signature-256'; }",
          "  if (secret) {",
          "    const body = pm.variables.replaceIn(pm.request.body.raw);",
          "    pm.request.headers.upsert({ key: header, value: 'sha256=' + cryptoJs.HmacSHA256(body, secret).toString() });",
          "  }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "emailSecret",
      "value": ""
    },
    {
      "key": "whatsappSecret",
      "value": ""
    },
    {
      "key": "transactionsSecret",
      "value": ""
    },
    {
      "key": "verifyToken",
      "value": ""
    },
    {
      "key": "serverHasSecrets",
      "value": "false"
    },
    {
      "key": "runId",
      "value": ""
    }
  ],
