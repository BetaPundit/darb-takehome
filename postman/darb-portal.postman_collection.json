        {
          "name": "Exact match (Desert Fleet) -> AUTO_MATCHED to txn_email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "email"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"messageId\":\"<{{runId}}.1@desertfleet>\",\"from\":\"accounts@desertfleet.example\",\"to\":[\"receipts@darb.sa\"],\"subject\":\"Tax invoice INV-88231\",\"attachments\":[{\"filename\":\"invoice.jpg\",\"contentType\":\"image/jpeg\",\"contentBase64\":\"REFSQi1GSVhUVVJFOmVtYWlsX2V4YWN0\"}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Processing (OCR + matching) happens AFTER the 200. Open /review or query the DB to see the outcome."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"accepted\", () => pm.expect(j.status).to.eql(\"accepted\"));",
                  "pm.test(\"one document\", () => pm.expect(j.documents).to.have.lengthOf(1));"
                ]
              }
            }
          ]
        },
