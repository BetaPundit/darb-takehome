    "next": "15.5.27",
    "next-safe-action": "^8.7.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
